# ========================================================
# VOID // SENTINEL — Person 3 Environment Configuration
# ========================================================

# Discord Webhook URL for real-time security alerts
# Example: https://discord.com/api/webhooks/1234567890/ABCDEF...
# If left blank, mock dispatches will be safely logged to the console
DISCORD_WEBHOOK_URL=

# Slack Webhook URL for incoming notifications
# Example: https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
# If left blank, mock dispatches will be safely logged to the console
SLACK_WEBHOOK_URL=

# Minimum severity threshold required to trigger outbound webhook alerts
# Options: LOW, MEDIUM, HIGH, CRITICAL (Default: MEDIUM)
# Note: Deception canaries trigger immediately regardless of severity setting
ALERT_MIN_SEVERITY=MEDIUM

# Alert cooldown window per (source_ip, attack_type) in seconds to prevent spam
ALERT_COOLDOWN_SECONDS=30

# SQLite database file path (Default: void_security_events.db)
VOID_DB_PATH=void_security_events.db

# Optional PostgreSQL Connection URL (Leave empty to use SQLite default)
# Example: postgresql://postgres:password@localhost:5432/void_sentinel
DATABASE_URL=

# Target backend URL for Person 1's API
VOID_BACKEND_URL=http://127.0.0.1:8000

# Port for Person 3's Dashboard Bridge API (Default: 8001)
BRIDGE_PORT=8001
